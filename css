{
    box-sizing: border-box;
}

body {
    background-color: #f4f4f4;
    color: #222222;
    font-family: Arial, Helvetica, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    margin: 0;
    padding: 0;
}

h1 {
    color: #ffffff;
    font-size: 36px;
    text-align: center;
    margin: 0;
}

h2 {
    color: #222222;
    font-size: 27px;
    margin-bottom: 15px;
}

h3 {
    color: #333333;
    font-size: 21px;
}

p {
    font-size: 16px;
    line-height: 1.8;
    margin-bottom: 18px;
}

.site-header {
    background-color: #171717;
    color: #ffffff;
    padding: 35px 20px;
    text-align: center;
    border-bottom: 5px solid #d4a017;
}

.site-header p {
    color: #ffffff;
    margin-bottom: 0;
}

main {
    max-width: 1100px;
    margin: 30px auto;
    padding: 25px;
}

section {
    background-color: #ffffff;
    color: #222222;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 8px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
}

.hip-hop-section {
    background-color: #ffffff;
    color: #222222;
    padding: 25px;
    border-left: 5px solid #d4a017;
    margin-bottom: 25px;
}

.hip-hop-image {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 20px auto;
    border-radius: 8px;
    border: 3px solid #222222;
}

.flex-container {
    display: flex;
    gap: 25px;
    align-items: stretch;
    justify-content: space-between;
    margin: 25px 0;
}

.flex-container section {
    flex: 1;
    min-width: 0;
}

#history {
    background-color: #ffffff;
    color: #222222;
    border-top: 5px solid #d4a017;
}

#modern {
    background-color: #eeeeee;
    color: #222222;
    border-top: 5px solid #222222;
}

ul,
ol {
    padding-left: 30px;
    margin-bottom: 20px;
}

li {
    margin-bottom: 8px;
}

a {
    color: #805500;
    text-decoration: underline;
    font-weight: bold;
}

a:hover {
    color: #222222;
    text-decoration: underline;
}

a:focus-visible,
button:focus-visible {
    outline: 3px solid #005fcc;
    outline-offset: 4px;
}

footer {
    background-color: #171717;
    color: #ffffff;
    text-align: center;
    padding: 25px;
    margin-top: 40px;
    border-top: 5px solid #d4a017;
}

footer a {
    color: #f2c14e;
}

footer a:hover {
    color: #ffffff;
}

.artists {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

.artists div {
    width: 250px;
    text-align: center;
}

.artists img {
    width: 100%;
    height: 250px;
    object-fit: cover;
    border-radius: 10px;
}

@media (max-width: 700px) {
    .flex-container {
        flex-direction: column;
        gap: 15px;
    }

    main {
        padding: 15px;
        margin: 15px auto;
    }

    h1 {
        font-size: 28px;
    }

    h2 {
        font-size: 23px;
    }

    section {
        padding: 18px;
    }

    .site-header {
        padding: 25px 15px;
    }

    footer {
        padding: 20px 15px;
    }

    .hip-hop-image {
        width: 100%;
        height: auto;
    }
}

@media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
    }
}
